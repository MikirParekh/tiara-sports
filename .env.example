# Tiara Sports Club - Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# Email Configuration (FormSubmit.co - Serverless)
# All form submissions will be sent to this email address
VITE_ADMIN_EMAIL=your-email@yourdomain.com
VITE_CONTACT_EMAIL=your-email@yourdomain.com

# Club Contact (Public - shown on website)
VITE_CLUB_PHONE="+91 (123) 456-7890"
VITE_CLUB_MOBILE="+91 98765 43210"
